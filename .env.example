# LOCAL/DEVELOPMENT ONLY. DEBUG=True일 때만 공개 더미 계정을 생성합니다.
DEMO_USERS_ENABLED='false'

# Private local object storage. Replace the password placeholder before Compose starts.
MINIO_ROOT_USER='minioadmin'
MINIO_ROOT_PASSWORD='replace-with-a-local-secret'
COMMUNITY_IMAGE_S3_BUCKET='community-images'
COMMUNITY_IMAGE_S3_REGION='us-east-1'
MINIO_API_PORT='9000'
MINIO_CONSOLE_PORT='9001'

# Local Docker uses Mailpit (SMTP 1025, web UI http://localhost:8025).
# Replace these values with your SMTP provider settings outside local development.
EMAIL_BACKEND='django.core.mail.backends.smtp.EmailBackend'
EMAIL_HOST='mailpit'
EMAIL_PORT='1025'
EMAIL_HOST_USER=''
EMAIL_HOST_PASSWORD=''
EMAIL_USE_TLS='false'
# Leave blank to fall back to EMAIL_HOST_USER, then webmaster@localhost.
DEFAULT_FROM_EMAIL=''

# Gmail deployment example (use a Google app password after enabling 2-Step Verification,
# never the normal Google account password):
# EMAIL_HOST='smtp.gmail.com'
# EMAIL_PORT='587'
# EMAIL_USE_TLS='true'
# EMAIL_HOST_USER='your-account@gmail.com'
# EMAIL_HOST_PASSWORD='your-google-app-password'
# DEFAULT_FROM_EMAIL='your-account@gmail.com'

# For local output without SMTP: EMAIL_BACKEND='django.core.mail.backends.console.EmailBackend'
# Local Mailpit web UI only; replace this sample outside local development.
MAILPIT_UI_AUTH='admin:adminpw'

